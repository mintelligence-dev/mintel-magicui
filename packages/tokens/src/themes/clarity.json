{
  "$description": "Mintel Clarity: a calm, content-first theme. Overrides only; anything not listed here comes from ../tokens.json. Mintel blue stays the tint.",
  "title": "Clarity",
  "description": {
    "en": "Calm and content-first: system font, larger reading sizes, layered dark mode, continuous corners.",
    "th": "เรียบและสงบ เน้นเนื้อหา ฟอนต์ระบบ ตัวอักษรใหญ่ขึ้น dark mode แยกชั้น มุมโค้งต่อเนื่อง"
  },
  "font": {
    "sans": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, var(--font-plex-thai, \"IBM Plex Sans Thai\"), sans-serif",
    "heading": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, var(--font-plex-thai, \"IBM Plex Sans Thai\"), sans-serif",
    "mono": "ui-monospace, Menlo, Consolas, monospace"
  },
  "radius": "0.875rem",
  "brandGradient": "linear-gradient(180deg, var(--brand-accent) 0%, var(--brand) 100%)",
  "glass": {
    "blur": "20px",
    "saturate": 1.9,
    "levels": {
      "thin": "10px",
      "regular": "20px",
      "thick": "32px"
    }
  },
