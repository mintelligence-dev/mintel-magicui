        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "monospace"
      ]
    }
  },
  "radius": {
    "base": {
      "$type": "dimension",
      "$value": "0.625rem"
    }
  },
  "glass": {
    "$description": "Frosted glass surface (non-color parts). Colors live in semantic.glass*.",
    "blur": {
      "$type": "dimension",
      "$value": "16px"
    },
    "saturate": {
      "$type": "number",
      "$value": 1.8
    },
    "levels": {
      "$description": "Blur per material level (thin → thick). Colors live in semantic.material-*.",
      "thin": {
        "$type": "dimension",
        "$value": "8px"
      },
      "regular": {
        "$type": "dimension",
        "$value": "16px"
      },
      "thick": {
        "$type": "dimension",
        "$value": "28px"
      }
    }
  },
  "motion": {
    "$description": "Durations, easings and spring presets. Springs are exported as JS physics params and as CSS linear() curves with a paired settle duration.",
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "100ms"
      },
      "fast": {
        "$type": "duration",
        "$value": "150ms"
      },
      "base": {
        "$type": "duration",
        "$value": "250ms"
      },
      "slow": {
        "$type": "duration",
        "$value": "400ms"
      },
      "slower": {
        "$type": "duration",
        "$value": "600ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      },
      "out": {
        "$type": "cubicBezier",
        "$value": [
          0.32,
          0.72,
          0,
          1
        ],
        "$description": "Decelerate (sheets, drawers)"
      },
      "in-out": {
        "$type": "cubicBezier",
        "$value": [
          0.65,
          0,
          0.35,
          1
        ]
      }
    },
    "spring": {
      "snappy": {
        "$type": "spring",
        "$value": {
          "stiffness": 400,
          "damping": 32,
          "mass": 1
        },
        "$description": "Buttons, toggles, tab indicators"
      },
      "smooth": {
        "$type": "spring",
        "$value": {
          "stiffness": 170,
          "damping": 26,
          "mass": 1
        },
        "$description": "Default for layout and reveals"
      },
      "bouncy": {
        "$type": "spring",
        "$value": {
          "stiffness": 300,
          "damping": 16,
          "mass": 1
        },
        "$description": "Playful accents (dock, badges)"
      }
    }
  }
