<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Mintel Site FAQ</masterLabel>
    <description>[Mintel UI] Frequently asked questions for Experience Cloud pages.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default,lightning__AppPage,lightning__HomePage">
            <property name="title" type="String" label="Title" default="Questions, answered" />
            <property name="description" type="String" label="Description" />
            <property name="questions" type="String" label="Questions (Question | Answer; …)" default="Which channels can I use? | LINE, Facebook Messenger and web chat. ; How fast will you reply? | Usually within a few minutes during business hours." />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
