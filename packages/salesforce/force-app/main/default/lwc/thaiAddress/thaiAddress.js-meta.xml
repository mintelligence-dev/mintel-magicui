<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Mintel Thai Address</masterLabel>
    <description>[Mintel UI] Thai province, district, sub-district and postal code, for Flow screens and Lightning pages.</description>
    <targets>
        <target>lightning__FlowScreen</target>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="locale" type="String" label="Language (th or en)" default="th" role="inputOnly" />
            <property name="required" type="Boolean" label="Required" default="false" role="inputOnly" />
            <property name="province" type="String" label="Province" role="outputOnly" />
            <property name="district" type="String" label="District" role="outputOnly" />
            <property name="subDistrict" type="String" label="Sub-district" role="outputOnly" />
            <property name="zip" type="String" label="Postal code" />
            <property name="provinceId" type="Integer" label="Province id" />
            <property name="districtId" type="Integer" label="District id" />
            <property name="subDistrictId" type="Integer" label="Sub-district id" />
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage">
            <property name="locale" type="String" label="Language" datasource="th,en" default="th" />
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
        <targetConfig targets="lightningCommunity__Default">
            <property name="locale" type="String" label="Language" datasource="th,en" default="th" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
