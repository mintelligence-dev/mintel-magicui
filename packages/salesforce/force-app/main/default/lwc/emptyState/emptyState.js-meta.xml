<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Mintel Empty State</masterLabel>
    <description>[Mintel UI] Branded empty state: icon in a halo, title, description and an optional action.</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage,lightning__AppPage,lightning__HomePage,lightningCommunity__Default">
            <property name="title" type="String" label="Title" default="Nothing here yet" />
            <property name="description" type="String" label="Description" />
            <property name="iconName" type="String" label="Icon (SLDS name)" default="utility:inbox" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
