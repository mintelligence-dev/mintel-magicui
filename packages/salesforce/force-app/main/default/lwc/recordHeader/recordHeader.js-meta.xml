<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Mintel Record Header</masterLabel>
    <description>Branded record header: icon, title, status badge and up to four highlight fields.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="titleField" type="String" label="Title field" default="Name" />
            <property name="fields" type="String" label="Highlight fields (comma-separated, up to 4)" default="" />
            <property name="statusField" type="String" label="Status field (picklist)" />
            <property name="statusVariants" type="String" label="Status colors (Value:variant)" />
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
