<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Mintel Activity Timeline</masterLabel>
    <description>[Mintel UI] Tasks and events for the record in one timeline (UI API GraphQL, no Apex).</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="limit" type="Integer" label="Most of each type to load" default="20" />
            <property name="label" type="String" label="Heading" />
            <property name="locale" type="String" label="Language" datasource="th,en" default="th" />
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
