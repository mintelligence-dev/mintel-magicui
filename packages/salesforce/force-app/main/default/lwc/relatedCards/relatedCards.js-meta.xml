<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Mintel Related Cards</masterLabel>
    <description>[Mintel UI] A related list (Cases, Opportunities, Contacts…) shown as cards. UI API only, no Apex.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="relatedListId" type="String" label="Related list API name" default="Cases" description="e.g. Cases, Opportunities, Contacts" />
            <property name="childObjectApiName" type="String" label="Child object API name" default="Case" />
            <property name="titleField" type="String" label="Title field" default="CaseNumber" />
            <property name="fields" type="String" label="More fields (comma-separated, up to 3)" default="Subject,Status,Priority" />
            <property name="sortBy" type="String" label="Sort by (prefix - for descending)" default="-CreatedDate" />
            <property name="pageSize" type="Integer" label="Cards to show" default="6" />
            <property name="label" type="String" label="Heading (defaults to the object's plural label)" />
            <property name="locale" type="String" label="Language" datasource="th,en" default="th" />
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
