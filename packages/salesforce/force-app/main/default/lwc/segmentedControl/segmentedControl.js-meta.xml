<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Mintel Segmented Control</masterLabel>
    <description>[Mintel UI] Segmented control with a spring-animated thumb.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage,lightning__RecordPage">
            <property name="options" type="String" label="Options (value:Label, comma-separated)" default="day:Day,week:Week,month:Month" />
            <property name="value" type="String" label="Selected value" default="week" />
            <property name="variant" type="String" label="Variant" datasource="default,brand" default="default" />
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
        <targetConfig targets="lightningCommunity__Default">
            <property name="options" type="String" label="Options (value:Label, comma-separated)" default="day:Day,week:Week,month:Month" />
            <property name="value" type="String" label="Selected value" default="week" />
            <property name="variant" type="String" label="Variant" datasource="default,brand" default="default" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
