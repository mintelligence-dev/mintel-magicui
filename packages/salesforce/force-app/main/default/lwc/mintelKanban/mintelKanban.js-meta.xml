<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Mintel Kanban</masterLabel>
    <description>Related records as a board grouped by a picklist; drag or "Move to" updates the record. UI API only.</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="relatedListId" type="String" label="Related list API name" default="Opportunities" />
            <property name="childObjectApiName" type="String" label="Child object API name" default="Opportunity" />
            <property name="groupField" type="String" label="Column picklist field" default="StageName" />
            <property name="titleField" type="String" label="Card title field" default="Name" />
            <property name="subtitleField" type="String" label="Card second line field" default="Amount" />
            <property name="hideValues" type="String" label="Picklist values to hide (comma-separated)" default="" />
            <property name="pageSize" type="Integer" label="Most records to load" default="50" />
            <property name="label" type="String" label="Heading" />
            <property name="locale" type="String" label="Language" datasource="th,en" default="th" />
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
