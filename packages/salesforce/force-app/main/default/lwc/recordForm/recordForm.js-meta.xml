<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Mintel Record Form</masterLabel>
    <description>[Mintel UI] Edit or create a record with fields grouped in sections; built on lightning-record-edit-form (no Apex).</description>
    <targets>
        <target>lightning__RecordPage</target>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="title" type="String" label="Title" />
            <property name="sections" type="String" label="Sections and fields" default="Details: Name" description="Section: Field, Field | Section: Field — API names of the object's fields; a list without a section name makes one untitled section" />
            <property name="columns" type="Integer" label="Columns on wide screens" datasource="1,2" default="2" />
            <property name="showCancel" type="Boolean" label="Show Cancel (reset)" default="false" />
            <property name="saveLabel" type="String" label="Save button label" />
            <property name="locale" type="String" label="Language" datasource="th,en" default="th" />
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="objectApiName" type="String" label="Object API name (new record)" default="Lead" />
            <property name="title" type="String" label="Title" default="New lead" />
            <property name="sections" type="String" label="Sections and fields" default="Contact: FirstName, LastName, Phone, Email | Company: Company, Industry" description="Section: Field, Field | Section: Field — API names of the object's fields; a list without a section name makes one untitled section" />
            <property name="columns" type="Integer" label="Columns on wide screens" datasource="1,2" default="2" />
            <property name="saveLabel" type="String" label="Save button label" />
            <property name="locale" type="String" label="Language" datasource="th,en" default="th" />
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String" label="Record Id" default="{!recordId}" />
            <property name="objectApiName" type="String" label="Object API name (new record)" />
            <property name="title" type="String" label="Title" />
            <property name="sections" type="String" label="Sections and fields" description="Section: Field, Field | Section: Field — API names of the object's fields; a list without a section name makes one untitled section" />
            <property name="columns" type="Integer" label="Columns on wide screens" datasource="1,2" default="2" />
            <property name="saveLabel" type="String" label="Save button label" />
            <property name="locale" type="String" label="Language" datasource="th,en" default="th" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
